{
  "failover_groups": [
    {
      "id": "cursor-agent-telegram",
      "primary_id": "cursor-agent-telegram",
      "backup_id": "cursor-agent-telegram-backup",
      "interval_sec": 3600,
      "fail_threshold": 2,
      "failback_threshold": 2,
      "auto_restart": false
    }
  ],
  "apps": [
    {
      "id": "gauth",
      "name": "gauth",
      "description": "Gmail OAuth / API / MCP",
      "port": 4664,
      "health_path": "/health",
      "app_dir": "../gauth",
      "launch_script": "launch.bat",
      "launch_args": "--background",
      "start_debug": {
        "launch_script": "launch.bat"
      },
      "control": "remote",
      "shutdown_path": "/api/local/shutdown"
    },
    {
      "id": "notetaker",
      "name": "notetaker",
      "description": "Meeting record, transcribe, diarize",
      "port": 6684,
      "health_path": "/api/health",
      "app_dir": "../notetaker",
      "launch_script": "notetaker.bat",
      "start_debug": {
        "launch_script": "notetaker.bat",
        "launch_args": "--debug"
      },
      "control": "remote",
      "shutdown_path": "/api/local/shutdown"
    },
    {
      "id": "ollama",
      "name": "Ollama",
      "description": "Standard Ollama LLM (not a c-app; notetaker and others may depend on it)",
      "port": 11434,
      "health_path": "/api/tags",
      "app_dir": ".",
      "launch_script": "",
      "control": "stub",
      "external": true
    },
    {
      "id": "voice-dictation",
      "name": "voice-dictation",
      "description": "Hotkey dictation → STT → type",
      "port": 8946,
      "health_path": "/health",
      "app_dir": "../voice-dictation",
      "launch_script": "start.bat",
      "launch_args": "--background",
      "start_debug": {
        "launch_args": "--skip-hotkey-agent --reload"
      },
      "control": "remote",
      "shutdown_path": "/api/local/shutdown"
    },
    {
      "id": "cursor-agent-telegram",
      "name": "cursor-agent Telegram (prod)",
      "description": "Prod Telegram + HA webhook",
      "port": 8947,
      "health_path": "/health",
      "health_probe": "http",
      "process_match": "-m cursor_chat.telegram_bot",
      "app_dir": "../cursor-agent",
      "launch_script": "telegram_bot-background.bat",
      "start_debug": {
        "launch_script": "telegram_bot.bat",
        "launch_args": "--verbose"
      },
      "control": "remote",
      "shutdown_path": "/api/local/shutdown",
      "stop_script": "telegram_bot-stop.bat"
    },
    {
      "id": "cursor-agent-telegram-backup",
      "name": "cursor-agent Telegram (backup)",
      "description": "Stable failover clone; capps starts when prod is down",
      "port": 8947,
      "health_path": "/health",
      "health_probe": "http",
      "process_match": "-m cursor_chat.telegram_bot",
      "app_dir": "../cursor-agent-backup",
      "launch_script": "telegram_bot-background.bat",
      "control": "script",
      "stop_script": "telegram_bot-stop.bat",
      "autostart": false
    }
  ]
}
